# Serves the built Vue app and forwards /api and /ws (WebSocket included) to the backend,
# so the browser sees one origin and needs no CORS. Runs as non-root on :8080.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy {$VCORTEX_BACKEND:backend:9002}
	}
	handle /ws/* {
		reverse_proxy {$VCORTEX_BACKEND:backend:9002}
	}

	handle {
		root * /srv

		# Vite puts a content hash in every file name under /assets: cache them forever.
		# Everything else (index.html, sw.js, manifest) must be checked on every load,
		# or a new release never reaches the browser.
		@mutable not path /assets/*
		header @mutable Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
