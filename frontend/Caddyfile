# serves the built vue app, forwards /api and /ws (websocket too) to the backend: one origin,
# no cors; non-root on :8080
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy {$VCORTEX_BACKEND:backend:9002}
	}
	handle /ws/* {
		reverse_proxy {$VCORTEX_BACKEND:backend:9002}
	}

	handle {
		root * /srv

		# vite hashes every file name under /assets: cache forever; everything else (index.html,
		# sw.js, manifest) is rechecked each load, or a new release never reaches the browser
		@mutable not path /assets/*
		header @mutable Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
