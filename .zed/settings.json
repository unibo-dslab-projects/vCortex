// clangd reads backend/build/compile_commands.json (`cmake --preset dev` in backend/) for
// the include paths of pcl, crow, eigen and nlohmann/json
{
  "lsp": {
    "clangd": {
      "binary": {
        "path": "/usr/bin/clangd",
        "arguments": ["--header-insertion=never"]
      }
    }
  }
}
